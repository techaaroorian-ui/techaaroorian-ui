{
  "name": "@techaaroorian-ui/contextual-empty",
  "version": "0.1.1-alpha.1",
  "description": "A contextual, composable empty-state system for React applications.",
  "author": "Janarthanan Soundararajan (@TechAaroorian)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techaaroorian-ui/techaaroorian-ui.git",
    "directory": "packages/contextual-empty"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "AI.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run --environment happy-dom",
    "test:watch": "vitest --environment happy-dom"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.11.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/techaaroorian-ui/techaaroorian-ui/tree/main/packages/contextual-empty#readme",
  "bugs": {
    "url": "https://github.com/techaaroorian-ui/techaaroorian-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "techaaroorian-ui",
    "react",
    "empty-state",
    "recovery-actions",
    "compound-components"
  ]
